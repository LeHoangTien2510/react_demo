name: demo
on:
  workflow_dispatch: 

jobs:
  job_1:
    runs-on: ubuntu-latest
    outputs:
      data: "${{steps.step_id.outputs.data_in}}"
    steps:
      - id: step_id
        run: |
          echo "data_in=1" >> $GITHUB_OUTPUT
  
  job_2:
    runs-on: ubuntu-latest
    needs: [job_1]
    outputs:
      data: "${{steps.step_id.outputs.data_in}}"
    steps:
      - id: step_id
        run: |
          echo "data_in=2" >> $GITHUB_OUTPUT

  job_3:
    runs-on: ubuntu-latest
    needs: [job_1,job_2]
    steps:
      - name: Gửi mail
        if: $(( ${{needs.job_1.outputs.data}} ${{needs.job_2.outputs.data}} )) == 3
        uses: dawidd6/action-send-mail@v3
        with:
          server_address: smtp.gmail.com
          server_port: 587
          username: sangrom2003@gmail.com
          password: ""
          subject: "Đây là tiêu đề gửi từ githubv action"
          body: "API trả về 200, kèm file response.json"
          to: sangrom2003@gmail.com
          from: sangrom2003@gmail.com